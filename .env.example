# ── Liga ─────────────────────────────────────────────
# Motor de los reclutas que forja Mastropiero: local | nan | llm
MASTRO_MOTOR=nan
# MASTRO_DB=data/mastro.db

# ── NaN ──────────────────────────────────────────────
NAN_API_KEY=
NAN_BASE_URL="https://api.nan.builders/v1"
# MiMo V2.6 Flash: poné el id exacto que devuelve `npm run mastro -- nan modelos`.
# Con esto puesto entra como último recurso en todas las cadenas de chat.
# NAN_MIMO_ID=
# Pisar la cadena de una clase (coma = fallback en orden):
# NAN_CADENA_GENERATIVO=deepseek-v4-flash,glm5.3-flash
# NAN_CADENA_CLASIFICADOR=qwen3.8-flash,deepseek-v4-flash

# ── Otro endpoint compatible OpenAI (motor llm) ──────
# MASTRO_LLM_BASE_URL=
# MASTRO_LLM_KEY=
# MASTRO_LLM_MODEL=
# MASTRO_EMBED_MODEL=

# ── Calendario (solo lectura) ────────────────────────
# Google Calendar → Configuración del calendario → «Dirección secreta en formato iCal». Varias, separadas por coma.
# GCAL_ICS_URLS=

# ── Web (buscar comunidades, oportunidades, gente) ──
# Tavily: 1.000 búsquedas/mes gratis, sin tarjeta → https://tavily.com
# TAVILY_API_KEY=
# Brave Search: plan gratis → https://brave.com/search/api/
# BRAVE_API_KEY=
