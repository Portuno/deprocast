{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "installCommand": "npm install --omit=dev",
  "regions": ["cdg1"],
  "functions": {
    "server.ts": {
      "maxDuration": 300,
      "includeFiles": "{web,src}/**/*,README.md,package.json"
    }
  },
  "crons": [
    {
      "path": "/api/latido",
      "schedule": "30 6 * * *"
    }
  ]
}
