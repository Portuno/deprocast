<?xml version="1.0" encoding="utf-8"?>
<!-- El widget: «Ahora» arriba, lo de ahora en grande, una línea de detalle, y Dictar y Validar abajo. Colores del tema oscuro de la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_hoy_raiz"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp"
  android:background="@drawable/widget_hoy_fondo">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="☿ AHORA"
    android:textColor="#C9A566"
    android:textSize="12sp"
    android:textStyle="bold"
    android:letterSpacing="0.08" />

  <TextView
    android:id="@+id/widget_hoy_titulo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:maxLines="2"
    android:ellipsize="end"
    android:textColor="#ECECEE"
    android:textSize="17sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_hoy_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textColor="#A3A5AD"
    android:textSize="13sp" />

  <View
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_hoy_dictar"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="🎙 Dictar"
      android:textColor="#0F1012"
      android:textSize="14sp"
      android:textStyle="bold"
      android:background="@drawable/widget_hoy_boton" />

    <TextView
      android:id="@+id/widget_hoy_validar"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:gravity="center"
      android:text="Validar"
      android:textColor="#C9A566"
      android:textSize="14sp"
      android:textStyle="bold"
      android:background="@drawable/widget_hoy_boton2" />
  </LinearLayout>
</LinearLayout>
