{
  "expo": {
    "name": "Deprocast",
    "slug": "deprocast",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deprocast.movil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1012",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deprocast.movil",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Deprocast escucha tu voz para que le hables o pienses en voz alta. El audio se procesa y se borra.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Deprocast anota por dónde anduviste, para el mapa de tu día. Queda solo en tu Deprocast.",
          "locationAlwaysAndWhenInUsePermission": "Deprocast anota tu recorrido aunque la app esté cerrada (con un aviso fijo), para el mapa de tu día. Se apaga desde la pestaña Mapa.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Deprocast rescata tus fotos recientes al vincular este teléfono (solo si lo elegís).",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "scheme": "deprocast",
    "extra": {
      "eas": {
        "projectId": "db03a2b5-ef44-4a8e-82dd-68c60a8b333a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db03a2b5-ef44-4a8e-82dd-68c60a8b333a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
