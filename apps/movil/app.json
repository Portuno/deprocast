{
  "expo": {
    "name": "Deprocast",
    "slug": "deprocast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deprocast.movil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1012",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deprocast.movil",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Deprocast escucha tu voz para que le hables o pienses en voz alta. El audio se procesa y se borra.",
          "enableBackgroundRecording": true
        }
      ]
    ],
    "scheme": "deprocast"
  }
}
