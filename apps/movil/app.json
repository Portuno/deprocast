{
  "expo": {
    "name": "Deprocast",
    "slug": "deprocast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deprocast.movil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1012",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deprocast.movil",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Deprocast escucha tu voz para que le hables o pienses en voz alta. El audio se procesa y se borra.",
          "enableBackgroundRecording": true
        }
      ]
    ],
    "scheme": "deprocast",
    "extra": {
      "eas": {
        "projectId": "db03a2b5-ef44-4a8e-82dd-68c60a8b333a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db03a2b5-ef44-4a8e-82dd-68c60a8b333a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
