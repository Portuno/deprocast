{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mastropiero",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "jugar"
      ],
      "port": 7272
    },
    {
      "name": "mastropiero-prueba",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--disable-warning=ExperimentalWarning",
        "src/servidor.ts",
        "--db",
        "data/prueba-ui.db",
        "--puerto",
        "7373",
        "--sin-rutinas",
        "--sin-telegram"
      ],
      "port": 7373
    },
    {
      "name": "mastropiero-medir",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--disable-warning=ExperimentalWarning",
        "src/servidor.ts",
        "--db",
        "data/medir.db",
        "--puerto",
        "7374",
        "--sin-rutinas",
        "--sin-telegram"
      ],
      "port": 7374
    }
  ]
}
